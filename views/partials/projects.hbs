<section class="section" id="projects">
  <div class="section__head">
    <h2 class="section__title">Projects</h2>
    <p class="section__note">Shipped work, research code and design files.</p>
  </div>
  <div class="section__body">
    <div class="cards">
      {{#each profile.projects}}
        <article class="card" data-reveal style="--i: {{@index}}">
          <p class="card__kind"><span>{{kind}}</span><span>{{period}}</span></p>
          <h3 class="card__title">{{title}}</h3>
          <p class="card__text">{{description}}</p>
          <ul class="tags">
            {{#each stack}}<li>{{this}}</li>{{/each}}
          </ul>
          {{#if links.length}}
            <p class="card__links">
              {{#each links}}
                <a class="link" href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>
              {{/each}}
            </p>
          {{/if}}
        </article>
      {{/each}}
      <a class="card card--cta" data-reveal href="https://github.com/ablatif78" target="_blank" rel="noopener noreferrer">
        <span class="card__kind"><span>Everything else</span></span>
        <span class="card__title">Browse the code on GitHub</span>
      </a>
    </div>
  </div>
</section>
