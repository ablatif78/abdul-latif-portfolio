<header class="topbar" data-topbar>
  <a class="topbar__name" href="#top">
    <span class="topbar__mark" aria-hidden="true">
      <svg viewBox="0 0 40 16" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M0 8h8l2 4 4-12 4 16 3-8h19" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    {{profile.name}}
  </a>
  <nav class="topbar__nav" aria-label="Sections">
    {{#each profile.nav}}
      <a href="#{{id}}" data-navlink>{{label}}</a>
    {{/each}}
  </nav>
  <button class="themetoggle" type="button" data-theme-toggle aria-label="Switch theme">
    <svg class="themetoggle__icon themetoggle__icon--sun" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
    </svg>
    <svg class="themetoggle__icon themetoggle__icon--moon" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.4A8.4 8.4 0 1 1 9.6 4a6.8 6.8 0 0 0 10.4 10.4Z" />
    </svg>
  </button>
  <a class="topbar__cta" href="#contact">Get in touch</a>
</header>
