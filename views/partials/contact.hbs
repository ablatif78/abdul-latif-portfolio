<section class="section section--contact" id="contact">
  <div class="section__head">
    <h2 class="section__title">Contact</h2>
    <p class="section__note">Replies land within a couple of days.</p>
  </div>
  <div class="section__body">
    <div class="contact">
      <div class="contact__intro" data-reveal>
        <p class="contact__lede">
          Hiring, collaborating on research, or after a site that earns its keep? Tell me what you
          are building.
        </p>
        <dl class="contact__direct">
          <div>
            <dt>Email</dt>
            <dd><a class="link" href="mailto:{{profile.email}}">{{profile.email}}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a class="link" href="tel:{{profile.phone}}">{{profile.phone}}</a></dd>
          </div>
          <div>
            <dt>CV</dt>
            <dd><a class="link" href="{{profile.cv.href}}" download>Download as PDF</a></dd>
          </div>
          <div>
            <dt>Located</dt>
            <dd>{{profile.location}} · from {{profile.origin}}</dd>
          </div>
        </dl>
        <ul class="contact__socials">
          {{#each profile.socials}}
            <li>
              <a href="{{url}}"{{#unless (startsWith url "mailto:")}} target="_blank" rel="noopener noreferrer"{{/unless}}>{{label}}</a>
            </li>
          {{/each}}
        </ul>
      </div>

      <form class="form" id="contact-form" novalidate data-reveal>
        <div class="form__row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder="Your full name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder="you@company.com" />
          </div>
        </div>
        <div class="field">
          <label for="subject">Subject <span class="field__hint">optional</span></label>
          <input id="subject" name="subject" type="text" maxlength="140" placeholder="A role, a project, a paper" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required maxlength="3000" placeholder="What are you working on?"></textarea>
        </div>
        <div class="field field--trap" aria-hidden="true">
          <label for="website">Leave this empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form__foot">
          <button class="button button--solid" type="submit" data-submit>
            <span data-submit-label>Send message</span>
            <span class="spinner" aria-hidden="true"></span>
          </button>
          <p class="form__status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
