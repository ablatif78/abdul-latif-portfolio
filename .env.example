# Server
PORT=3000
NODE_ENV=development

# Public site URL (used for canonical tags / Open Graph)
SITE_URL=http://localhost:3000

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be a verified Resend domain/sender, e.g. "Portfolio <hello@yourdomain.com>".
# Use "onboarding@resend.dev" while testing before a domain is verified.
MAIL_FROM=Portfolio <onboarding@resend.dev>

# Where contact-form messages are delivered
MAIL_TO=abdullatif.cse@gmail.com

# Set to true to also send the visitor a "thanks, I'll reply" confirmation.
# Needs a verified domain — a resend.dev sender cannot email strangers.
MAIL_SEND_ACK=false
